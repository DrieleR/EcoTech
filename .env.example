# ---------- Front-end (Vite) ----------
# Endereço da API. Em dev, "/api" passa pelo proxy do Vite até o backend.
VITE_API_URL=/api
# true = usa o servidor simulado no navegador, sem backend (só em npm run dev)
VITE_USE_MOCK=false

# ---------- Backend (server/) ----------
# Só o servidor lê estas variáveis. Nunca use o prefixo VITE_ nelas:
# tudo que começa com VITE_ vai parar no JavaScript do navegador.
# URL do Neon: painel do Neon > Connect > "Pooled connection".
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
# Endereço do site, usado nos links de e-mail (ex.: redefinir senha) e no CORS
# quando o front é publicado em outro domínio
# FRONTEND_URL=http://localhost:5173

# Pagamento simulado: ler o QR Code aprova a inscrição sem cobrar nada.
# Deixe "true" só em desenvolvimento. Em produção, sem isso, ninguém consegue
# se inscrever "de graça" por essa rota.
PAGAMENTO_SIMULADO=true
